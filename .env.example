# .env.example
#
# PURPOSE
#   Template for the environment variables read by app/config.py.
#   Copy to .env (git-ignored) and fill in local values. Never put real
#   credentials in this file.
#
# TO ADD (one KEY=placeholder line each; names must match app/config.py)
#   PostgreSQL: POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
#   MongoDB:    MONGO_URI, MONGO_DB
#   Redis:      REDIS_HOST, REDIS_PORT, REDIS_DB
#   Cache:      CACHE_TTL_SECONDS
#   Session:    SESSION_SECRET (required - read in app/main.py; signs the login
#               session cookie, so the app will not start without it),
#               SESSION_HTTPS_ONLY (optional, set to true in deployed environments)
#   Admin:      ADMIN_SIGNUP_CODE (required for administrator signup - read in
#               app/routers/auth.py; without it the signup page rejects every
#               administrator registration)
