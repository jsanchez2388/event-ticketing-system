# Template for the environment variables the application reads.
# Copy to .env (git-ignored) and fill in your own values:
#     cp .env.example .env
# Never commit real credentials. Every value below is a placeholder.


# ---------- PostgreSQL (required) ----------
# One full libpq connection string, not separate host/user/password parts.
# Neon supplies this on the project dashboard; keep ?sslmode=require.
POSTGRES_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require


# ---------- MongoDB (required) ----------
# Atlas connection string, or mongodb://localhost:27017 for a local server.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=event_ticketing


# ---------- Redis (optional: these are the defaults) ----------
# docker-compose.yml starts a Redis on localhost:6379, which matches these.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Set REDIS_URL only for a remote or password-protected instance. When it is
# set it is used as-is and the three values above are ignored.
# REDIS_URL=redis://:PASSWORD@HOST:6379/0


# ---------- Event cache (optional) ----------
# How long a cached event stays in Redis, in seconds. Default 60.
CACHE_TTL_SECONDS=60


# ---------- Session (SESSION_SECRET is required) ----------
# Signs the login session cookie. The app refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string

# Send the session cookie over HTTPS only. Leave false for localhost.
SESSION_HTTPS_ONLY=false


# ---------- Administrator signup (required to create an admin) ----------
# The signup page asks for this code before it will create an admin account.
# Without it, every administrator registration is rejected.
ADMIN_SIGNUP_CODE=replace-with-a-shared-code
